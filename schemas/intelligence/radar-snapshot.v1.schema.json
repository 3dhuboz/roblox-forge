{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.robloxforge.dev/intelligence/radar-snapshot.v1.schema.json",
  "title": "RobloxForge Public Radar Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "asOf",
    "expiresAt",
    "corpusRecordIds",
    "entries",
    "provenance",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "maxLength": 16
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "asOf": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "corpusRecordIds": {
      "$ref": "common.schema.json#/$defs/nonEmptyIdArray"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": [
            "id",
            "universeId",
            "rootPlaceId",
            "gameLabel",
            "publicUrl",
            "signals",
            "ordinalScores",
            "patternTags",
            "publicOffers",
            "discontinuities"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "universeId": {
              "$ref": "#/$defs/robloxId"
            },
            "rootPlaceId": {
              "$ref": "#/$defs/robloxId"
            },
          "gameLabel": {
            "$ref": "common.schema.json#/$defs/label"
          },
          "publicUrl": {
            "$ref": "common.schema.json#/$defs/publicHttpsUri"
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "$ref": "#/$defs/publicSignal"
            }
          },
          "ordinalScores": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/ordinalScore"
            }
          },
            "patternTags": {
              "$ref": "common.schema.json#/$defs/labelArray"
            },
            "publicOffers": {
              "type": "array",
              "maxItems": 18,
              "items": {
                "$ref": "#/$defs/publicOfferEvidence"
              }
            },
            "discontinuities": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/counterDiscontinuity"
              }
            }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/radarProvenanceLink"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    }
  },
  "$defs": {
    "radarProvenanceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenanceId", "evidenceIds", "traceIds"],
      "properties": {
        "provenanceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 640,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "traceIds": {
          "$ref": "common.schema.json#/$defs/nonEmptyIdArray"
        }
      }
    },
    "robloxId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "publicOfferEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "offerType",
        "offerId",
        "sourceUrl",
        "observedAt",
        "locale",
        "priceContext",
        "priceRobux"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "offerType": {
          "type": "string",
          "enum": [
            "game_pass",
            "developer_product",
            "paid_access",
            "private_server",
            "subscription"
          ],
          "maxLength": 32
        },
        "offerId": {
          "anyOf": [
            { "$ref": "#/$defs/robloxId" },
            { "type": "null" }
          ]
        },
        "sourceUrl": {
          "$ref": "common.schema.json#/$defs/publicHttpsUri"
        },
        "observedAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "priceContext": {
          "type": "string",
          "enum": [
            "anonymous_public_page",
            "authenticated_public_page",
            "unavailable"
          ],
          "maxLength": 32
        },
        "priceRobux": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "counterDiscontinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "previousValue",
        "currentValue",
        "previousEvidenceId",
        "evidenceId",
        "observedAt"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "enum": ["visits", "favorites"],
          "maxLength": 16
        },
        "previousValue": {
          "type": "integer",
          "minimum": 0
        },
        "currentValue": {
          "type": "integer",
          "minimum": 0
        },
        "previousEvidenceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "evidenceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "observedAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        }
      }
    },
    "publicSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "ordinalBand",
        "evidenceId",
        "sourceUrl",
        "observedAt",
        "expiresAt",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "metric": {
          "type": "string",
          "enum": [
            "visits",
            "favorites",
            "ccu",
            "update-cadence",
            "discovery-position",
            "public-rating",
            "public-offer"
          ],
          "maxLength": 32
        },
        "ordinalBand": {
          "$ref": "common.schema.json#/$defs/ordinalBand"
        },
        "evidenceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "sourceUrl": {
          "$ref": "common.schema.json#/$defs/publicHttpsUri"
        },
        "observedAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "confidence": {
          "$ref": "common.schema.json#/$defs/confidence"
        }
      }
    },
    "ordinalScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "score", "evidenceIds", "confidence", "asOf"],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": ["visibility", "momentum", "recency"],
          "maxLength": 32
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "evidenceIds": {
          "$ref": "common.schema.json#/$defs/nonEmptyIdArray"
        },
        "confidence": {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        "asOf": {
          "$ref": "common.schema.json#/$defs/dateTime"
        }
      }
    }
  }
}
