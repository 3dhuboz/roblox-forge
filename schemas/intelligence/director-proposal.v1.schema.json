      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/briefSetFieldOperation"
          },
          {
            "$ref": "#/$defs/questionAnswerOperation"
